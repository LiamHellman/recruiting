# Copy to backend/.env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://recruiting:recruiting@localhost:5432/recruiting
REDIS_URL=redis://localhost:6379/0

# Claude API key: put the real value in backend/.env (gitignored), NEVER in this file,
# which is committed. Only needed for live calls (POST /jobs, evals), never for unit tests.
ANTHROPIC_API_KEY=

# GitHub token for collecting candidate-submitted accounts (Phase 3). Real value in
# backend/.env only. A fine-grained token with no extra permissions (public data) is enough.
GITHUB_TOKEN=

# Token budgets (input + output + cache tokens).
LLM_JOB_TOKEN_BUDGET=500000
LLM_TENANT_TOKEN_BUDGET=20000000

# Postgres-backed tests migrate this database up and down; use a throwaway one.
TEST_DATABASE_URL=postgresql+psycopg://recruiting:recruiting@localhost:5432/recruiting_test
# The end-to-end queue test flushes this Redis database; use one nothing else uses.
TEST_REDIS_URL=redis://localhost:6379/15
